{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zapret-ui",
  "version": "1.0.0",
  "identifier": "com.zapret.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zapret-ui",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "transparent": false,
        "resizable": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "GUI manager for flowseal-zapret (zapret-discord-youtube)",
    "longDescription": "zapret-ui is an unofficial Windows 11 GUI manager for zapret-discord-youtube by Flowseal. The runtime is downloaded separately from the upstream GitHub releases. WinDivert is distributed as part of the upstream runtime and is licensed under LGPL-3.0 or GPL-2.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
